APP_NAME=Sporty
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://sporty:sporty@localhost:5432/sporty
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300
DATABASE_CONNECT_TIMEOUT=10
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=20
REDIS_HEALTH_CHECK_INTERVAL=30
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
API_KEY=
DOCS_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
LOGFIRE_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=if-token-present
LOGFIRE_SERVICE_NAME=Sporty
LOGFIRE_SERVICE_VERSION=0.1.0
LOGFIRE_ENVIRONMENT=development
SPORTYBET_BASE_URL=https://www.sportybet.com
SPORTYBET_REGION=ng
SPORTYBET_TIMEOUT=15
SPORTYBET_MIN_INTERVAL=0.25
SPORTYBET_MAX_RETRIES=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
