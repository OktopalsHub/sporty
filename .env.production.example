# Sporty — MINIMAL production environment
# Copy these into: FastAPI Cloud dashboard → Environment variables
# (Everything in .env.example that is NOT listed here has a safe default — skip it.)


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Your Neon Postgres connection string.
# Both forms work (the app forces the psycopg3 driver automatically):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=CHANGE-ME-to-a-long-random-string

# Only set APP_ENV=production once API_KEY above is set — production boot
# refuses to start without an API_KEY. This is what protects /api/v1/* routes.
APP_ENV=production


# ─── REQUIRED ONLY IF YOU HAVE A REDIS IN PRODUCTION ─────────────────────────
# If you have a Redis (Upstash/Redis Cloud/etc.), point to it:
REDIS_URL=redis://HOST:6379/0
#
# If you do NOT have a Redis, DELETE the line above and instead set:
# RATE_LIMIT_FAIL_CLOSED=false
# (fail-closed is ON by default: no Redis => every /api/v1 call except
#  /health and /ready returns 503 "rate_limit_unavailable")


# ─── NEEDED FOR THE AI FEATURES (predictions, generators, analysis) ──────────
GEMINI_API_KEY=CHANGE-ME-your-gemini-key

# ─── SPORTYBET PROVIDER ──────────────────────────────────────────────────────
SPORTYBET_PROVIDER=parse
PARSE_API_KEY=CHANGE-ME-parse-key
PARSE_API_BASE_URL=https://api.parse.bot/scraper/8e652912-d760-4522-85ce-071e539a9c12


# ─── RECOMMENDED (defense in depth; code also enforces it) ───────────────────
TRUSTED_HOSTS=sporty.fastapicloud.dev


# ─── ONLY IF A FRONTEND ON ANOTHER DOMAIN CALLS THIS API ─────────────────────
# FRONTEND_ORIGINS=https://your-frontend-domain.com


# ─── NOTE ────────────────────────────────────────────────────────────────────
# With API_KEY set, every /api/v1/* route except /health and /ready requires
# the header:  X-API-Key: <your API_KEY>   (/docs has an "Authorize" button).
